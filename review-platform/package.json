{
  "name": "smart-review-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Arabic-first Google Review landing pages for NFC cards (static, zero-backend).",
  "scripts": {
    "dev": "astro dev",
    "validate": "node scripts/validate-config.ts",
    "admin": "node scripts/admin.ts",
    "typecheck": "astro check",
    "build": "npm run validate && astro build",
    "preview": "astro preview",
    "test:unit": "node --test tests/unit.test.ts",
    "test:build": "node --test tests/build.test.ts",
    "test:browser": "node tests/browser.test.mjs",
    "test": "npm run validate && npm run typecheck && npm run build && npm run test:unit && npm run test:build && npm run test:browser",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^22.20.5",
    "axe-core": "4.10.2",
    "playwright-core": "1.52.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
